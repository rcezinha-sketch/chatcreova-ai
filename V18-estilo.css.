*{
  box-sizing:border-box;
}

:root{
  --bg:#03091b;
  --bg2:#061331;
  --panel:#091a43;
  --panel2:#0d2358;
  --cobalt:#1557ff;
  --cobalt2:#0b3fc7;
  --gold:#f2c14e;
  --gold2:#b98924;
  --text:#f7f9ff;
  --muted:#9eabd0;
  --border:#193b78;
  --success:#62e59b;
  --danger:#ff7b8d;
}

body{
  margin:0;
  background:
    radial-gradient(circle at 75% 5%,rgba(21,87,255,.18),transparent 30%),
    linear-gradient(145deg,#020716,#06112e 55%,#03091b);
  color:var(--text);
  font-family:Arial,sans-serif;
  min-height:100vh;
}

button,
input,
textarea,
select{
  font:inherit;
}

button{
  cursor:pointer;
}

.topbar{
  height:66px;
  display:flex;
  align-items:center;
  padding:0 24px;
  background:rgba(4,13,38,.96);
  border-bottom:1px solid var(--border);
  box-shadow:0 8px 28px rgba(0,0,0,.22);
}

.brand{
  font-size:21px;
  font-weight:800;
  letter-spacing:-.3px;
  margin-right:auto;
}

.brand i{
  color:var(--gold);
  font-style:normal;
}

.version{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-width:42px;
  padding:6px 10px;
  border:1px solid rgba(242,193,78,.45);
  border-radius:999px;
  color:var(--gold);
  background:rgba(242,193,78,.07);
  font-size:12px;
  font-weight:bold;
}

.layout{
  display:grid;
  grid-template-columns:260px 1fr;
  min-height:calc(100vh - 66px);
}

.sidebar{
  display:flex;
  flex-direction:column;
  padding:14px 10px;
  background:
    linear-gradient(180deg,#061431,#071a42 55%,#05112c);
  border-right:1px solid var(--border);
}

.sidebar h6{
  color:#7184ba;
  letter-spacing:1.2px;
  margin:15px 12px 6px;
  font-size:10px;
}

.sidebar button{
  width:100%;
  text-align:left;
  padding:11px 12px;
  margin:2px 0;
  border:1px solid transparent;
  border-radius:10px;
  background:transparent;
  color:#eef3ff;
  transition:.18s ease;
}

.sidebar button:hover{
  background:linear-gradient(
    90deg,
    rgba(21,87,255,.24),
    rgba(242,193,78,.06)
  );
  border-color:#2753a0;
  box-shadow:inset 3px 0 var(--gold);
  transform:translateX(2px);
}

.sidebar button span{
  margin-left:7px;
}

.ai-indicator{
  margin-top:auto;
  padding:14px 13px;
  border-top:1px solid rgba(80,112,180,.25);
  color:var(--muted);
  font-size:12px;
}

#aiDot{
  color:#8190b8;
  margin-right:5px;
}

#aiStatus[data-state="connected"]{
  color:var(--success);
}

#aiStatus[data-state="error"]{
  color:var(--danger);
}

.ai-indicator:has(#aiStatus[data-state="connected"]) #aiDot{
  color:var(--success);
}

.ai-indicator:has(#aiStatus[data-state="error"]) #aiDot{
  color:var(--danger);
}

main{
  padding:42px 5vw 55px;
  overflow:hidden;
}

.view{
  display:none;
  max-width:1050px;
  margin:auto;
  animation:fadeIn .22s ease;
}

.view.active{
  display:block;
}

@keyframes fadeIn{
  from{
    opacity:0;
    transform:translateY(5px);
  }
  to{
    opacity:1;
    transform:none;
  }
}

.pill{
  display:inline-block;
  font-size:10px;
  letter-spacing:1.35px;
  font-weight:bold;
  color:var(--gold);
  border:1px solid rgba(242,193,78,.35);
  background:rgba(242,193,78,.06);
  border-radius:999px;
  padding:7px 11px;
}

h1{
  font-size:clamp(38px,5vw,60px);
  letter-spacing:-2px;
  line-height:1.02;
  margin:14px 0 8px;
}

h1 em{
  color:var(--gold);
  font-style:normal;
}

h2{
  margin-top:0;
}

p{
  color:var(--muted);
  line-height:1.55;
}

input,
textarea,
select{
  width:100%;
  border:1px solid var(--border);
  background:#061432;
  color:#fff;
  outline:none;
  border-radius:11px;
  padding:13px 14px;
  transition:.18s ease;
}

input:focus,
textarea:focus,
select:focus{
  border-color:#356bdb;
  box-shadow:0 0 0 3px rgba(21,87,255,.12);
}

textarea{
  resize:vertical;
}

#channelSelect{
  margin-top:18px;
}

#messages{
  min-height:300px;
  max-height:50vh;
  overflow:auto;
  padding:14px 0;
}

.msg{
  max-width:82%;
  padding:16px 18px;
  border-radius:17px;
  margin:10px 0;
}

.msg p{
  margin-bottom:0;
  white-space:pre-wrap;
}

.msg.ai{
  background:
    linear-gradient(145deg,#0a1d4b,#0b2459);
  border:1px solid #1a478d;
  box-shadow:0 10px 28px rgba(0,0,0,.14);
}

.msg.ai b{
  color:var(--gold);
}

.msg.user{
  margin-left:auto;
  background:
    linear-gradient(135deg,var(--cobalt2),var(--cobalt));
  border:1px solid rgba(255,255,255,.1);
}

.msg.user p{
  color:#fff;
}

.composer{
  display:grid;
  grid-template-columns:1fr auto;
  gap:9px;
  position:sticky;
  bottom:12px;
  padding:9px;
  border:1px solid #2857aa;
  border-radius:18px;
  background:rgba(6,20,50,.96);
  box-shadow:0 16px 40px rgba(0,0,0,.3);
}

.composer textarea{
  min-height:58px;
  max-height:170px;
  border:0;
  background:transparent;
  padding:15px;
  box-shadow:none;
}

.composer button,
.generate,
.panel button,
#helpSend{
  border:1px solid rgba(242,193,78,.55);
  border-radius:11px;
  color:#07112b;
  font-weight:800;
  background:
    linear-gradient(135deg,#ffe18a,var(--gold),#c89528);
  padding:12px 18px;
  box-shadow:0 8px 24px rgba(185,137,36,.15);
}

.composer button:hover,
.generate:hover,
.panel button:hover,
#helpSend:hover{
  filter:brightness(1.07);
  transform:translateY(-1px);
}

.composer button:disabled,
.generate:disabled{
  opacity:.55;
  cursor:not-allowed;
  transform:none;
}

.panel{
  display:grid;
  gap:12px;
  margin-top:22px;
  padding:22px;
  border-radius:19px;
  background:
    linear-gradient(145deg,rgba(11,31,77,.96),rgba(7,21,54,.96));
  border:1px solid #1d4383;
  box-shadow:
    0 18px 45px rgba(0,0,0,.2),
    inset 0 1px rgba(255,255,255,.025);
}

.panel textarea{
  min-height:130px;
}

.form-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:11px;
}

.generate{
  justify-self:start;
}

.result{
  display:none;
  white-space:pre-wrap;
  line-height:1.6;
  padding:17px;
  border-radius:13px;
  background:#06132f;
  border:1px solid #1b4388;
  color:#edf2ff;
}

.result.show{
  display:block;
}

.counter{
  text-align:right;
  color:#7f91bd;
  font-size:12px;
  margin-top:-6px;
}

#channelCards{
  display:grid;
  gap:10px;
  margin-top:16px;
}

.channel-card{
  padding:16px;
  border:1px solid var(--border);
  border-radius:13px;
  background:#08183c;
}

.modal{
  display:none;
  position:fixed;
  inset:0;
  z-index:100;
  place-items:center;
  background:rgba(1,5,18,.88);
  backdrop-filter:blur(5px);
  padding:20px;
}

.modal.open{
  display:grid;
}

.box{
  width:min(650px,100%);
  position:relative;
  padding:27px;
  border-radius:20px;
  background:
    linear-gradient(145deg,#0a1a43,#071331);
  border:1px solid rgba(242,193,78,.45);
  box-shadow:0 30px 80px rgba(0,0,0,.5);
}

.box #closeHelp{
  position:absolute;
  right:12px;
  top:12px;
  background:transparent;
  color:#fff;
  border:0;
  font-size:17px;
}

#helpInput{
  min-height:120px;
  margin:8px 0 12px;
}

#helpAnswer{
  white-space:pre-wrap;
  color:#eef3ff;
  line-height:1.55;
  max-height:300px;
  overflow:auto;
}

::-webkit-scrollbar{
  width:8px;
}

::-webkit-scrollbar-track{
  background:#04102a;
}

::-webkit-scrollbar-thumb{
  background:#21488e;
  border-radius:999px;
}

::-webkit-scrollbar-thumb:hover{
  background:#315eb0;
}

@media(max-width:760px){

  .topbar{
    padding:0 14px;
  }

  .layout{
    grid-template-columns:70px 1fr;
  }

  .sidebar{
    padding:12px 6px;
  }

  .sidebar h6{
    display:none;
  }

  .sidebar button{
    text-align:center;
    font-size:20px;
    padding:11px 5px;
  }

  .sidebar button span{
    display:none;
  }

  .ai-indicator{
    text-align:center;
    padding:12px 2px;
  }

  #aiStatus{
    display:none;
  }

  main{
    padding:28px 14px 45px;
  }

  h1{
    font-size:38px;
  }

  .form-grid{
    grid-template-columns:1fr;
  }

  .msg{
    max-width:94%;
  }

  .composer{
    grid-template-columns:1fr;
  }

  .composer button{
    width:100%;
  }

  .panel{
    padding:16px;
  }
}
